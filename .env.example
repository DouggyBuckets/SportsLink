# Copy to .env (gitignored). Local values come from `npx supabase status`.
# On a physical phone, replace 127.0.0.1 with your computer's LAN IP.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable (anon) key only. Never put the secret / service role key in the app.
EXPO_PUBLIC_SUPABASE_KEY=
